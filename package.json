{
  "name": "ultimate-express-trading-service",
  "version": "1.0.0",
  "description": "Production-ready backend microservice with Ultimate Express Framework, Sequelize, MariaDB, Redis, MindsDB, and trading strategies",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/index.js",
    "start:prod": "pm2 start ecosystem.config.cjs --env production --no-daemon",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:init": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "lint": "bun x eslint . --ext .ts --max-warnings 100000",
    "format": "prettier --write .",
    "test": "bun x jest --config jest.config.ts --coverage",
    "test:watch": "bun x jest --config jest.config.ts --watch",
    "prepare": "husky install"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv-safe": "^9.0.0",
    "ioredis": "^5.4.1",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "sequelize": "^6.37.3",
    "ultimate-express": "^2.0.13",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/express": "^4.17.21",
    "@types/dotenv-safe": "^9.1.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "@types/node-cron": "^3.0.11",
    "sqlite3": "^5.1.7",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.3",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "pm2": "^5.3.0",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "supertest": "^7.0.0"
  }
}
